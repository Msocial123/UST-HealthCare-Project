                      "value": 99,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<",
                      "value": 99.5,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 99.5,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "scheduling-service availability SLI",
              "autoscale": true,
              "precision": 2,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h",
