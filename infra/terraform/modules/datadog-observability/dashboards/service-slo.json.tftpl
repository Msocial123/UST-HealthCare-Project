              "y": 4,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "appointment-service latency SLO (p95)",
              "slo_id": "${slo.appointment_service_latency}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 9,
              "y": 4,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo_list",
              "title": "All Smart Hospital SLOs",
              "requests": [
                {
                  "request_type": "slo_list",
                  "query": {
                    "query_string": "project:smart-hospital",
                    "limit": 50
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 4
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 12,
        "height": 11
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "SLA compliance",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Availability % by service vs SLO and SLA",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.fastapi.request.hits{env:$env,service:$service} by {service}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "e",
                      "query": "sum:trace.fastapi.request.errors{env:$env,service:$service} by {service}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(h - e) / h * 100",
                      "alias": "availability %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = ${availability_target}",
                  "display_type": "warning dashed",
                  "label": "SLO ${availability_target}%"
                },
                {
                  "value": "y = ${sla_target}",
                  "display_type": "error dashed",
                  "label": "SLA ${sla_target}%"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 17,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Golden signals",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Requests/s by service",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:trace.fastapi.request.hits{env:$env,service:$service} by {service}.as_rate()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Error rate % by service",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "e",
                      "query": "sum:trace.fastapi.request.errors{env:$env,service:$service} by {service}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.fastapi.request.hits{env:$env,service:$service} by {service}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "e / h * 100",
                      "alias": "error %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "p95 latency by service",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "p95:trace.fastapi.request{env:$env,service:$service} by {service}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "second"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = ${latency_threshold_s}",
                  "display_type": "error dashed",
                  "label": "${latency_threshold_ms} ms"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "p50 / p99 latency (all services)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p50",
                      "query": "p50:trace.fastapi.request{env:$env,service:$service}",
                      "aggregator": "avg"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p99",
                      "query": "p99:trace.fastapi.request{env:$env,service:$service}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
