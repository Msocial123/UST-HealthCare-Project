            },
            "layout": {
              "x": 3,
              "y": 4,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "appointment-service availability SLO",
              "slo_id": "${slo.appointment_service_availability}",
              "time_windows": [
                "7d",
                "30d"
              ],
