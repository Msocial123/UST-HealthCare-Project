              ]
            },
            "layout": {
              "x": 10,
              "y": 0,
              "width": 2,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "SLO status and error budget",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "slo",
              "title": "identity-service availability SLO",
              "slo_id": "${slo.identity_service_availability}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "identity-service latency SLO (p95)",
              "slo_id": "${slo.identity_service_latency}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "patient-service availability SLO",
              "slo_id": "${slo.patient_service_availability}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "patient-service latency SLO (p95)",
              "slo_id": "${slo.patient_service_latency}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "provider-service availability SLO",
              "slo_id": "${slo.provider_service_availability}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "provider-service latency SLO (p95)",
              "slo_id": "${slo.provider_service_latency}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 3,
              "y": 2,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "facility-service availability SLO",
              "slo_id": "${slo.facility_service_availability}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 6,
              "y": 2,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "facility-service latency SLO (p95)",
              "slo_id": "${slo.facility_service_latency}",
              "time_windows": [
                "7d",
                "30d"
              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 9,
              "y": 2,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "scheduling-service availability SLO",
              "slo_id": "${slo.scheduling_service_availability}",
              "time_windows": [
