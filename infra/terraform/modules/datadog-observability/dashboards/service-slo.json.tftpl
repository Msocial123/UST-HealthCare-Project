                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "appointment-service availability SLI",
              "autoscale": true,
              "precision": 2,
              "requests": [
                {
                  "queries": [
                    {
