              ],
              "view_type": "detail",
              "view_mode": "overall",
              "show_error_budget": true,
              "global_time_target": "0"
            },
            "layout": {
              "x": 0,
              "y": 4,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "slo",
              "title": "scheduling-service latency SLO (p95)",
