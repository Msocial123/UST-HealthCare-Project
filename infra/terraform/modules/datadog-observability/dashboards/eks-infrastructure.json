{
  "title": "Smart Hospital - EKS Infrastructure (dev)",
  "description": "CPU, memory, network in/out and node utilization for the smart-hospital-dev-eks cluster, from the Datadog Agent. Managed by Terraform (infra/terraform/environments/dev-observability).",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "cluster",
      "prefix": "kube_cluster_name",
      "default": "smart-hospital-dev-eks"
    },
    {
      "name": "namespace",
      "prefix": "kube_namespace",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Cluster overview",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Nodes",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes_state.node.count{$cluster}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Pods running",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes_state.pod.status_phase{$cluster,pod_phase:running,$namespace}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 2,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Avg node CPU %",
              "autoscale": true,
              "precision": 1,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.cpu.idle{$cluster}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 - a",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 85,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Avg node memory %",
              "autoscale": true,
              "precision": 1,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.mem.pct_usable{$cluster}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 - a * 100",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 85,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "CPU requested % of allocatable",
              "autoscale": true,
              "precision": 1,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:kubernetes_state.container.cpu_requested{$cluster}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:kubernetes_state.node.cpu_allocatable{$cluster}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "r / c * 100",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 85,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Memory requested % of allocatable",
              "autoscale": true,
              "precision": 1,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:kubernetes_state.container.memory_requested{$cluster}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:kubernetes_state.node.memory_allocatable{$cluster}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "r / c * 100",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 85,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 10,
              "y": 0,
              "width": 2,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "CPU utilization",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Node CPU % by host",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.cpu.idle{$cluster} by {host}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 - a",
                      "alias": "CPU %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "error dashed",
                  "label": "85%"
                },
                {
                  "value": "y = 70",
                  "display_type": "warning dashed",
                  "label": "70%"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Container CPU (cores) by deployment",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes.cpu.usage.total{$cluster,$namespace} by {kube_deployment}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a / 1000000000",
                      "alias": "cores"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "area"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Memory utilization",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Node memory % used by host",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.mem.pct_usable{$cluster} by {host}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 - a * 100",
                      "alias": "memory %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "error dashed",
                  "label": "85%"
                },
                {
                  "value": "y = 70",
                  "display_type": "warning dashed",
                  "label": "70%"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Container memory by deployment",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes.memory.usage{$cluster,$namespace} by {kube_deployment}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "byte_in_binary_bytes_family"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "area"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Network in / out",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Node network in (bytes/s) by host",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:system.net.bytes_rcvd{$cluster} by {host}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "in",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "byte_in_binary_bytes_family"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Node network out (bytes/s) by host",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:system.net.bytes_sent{$cluster} by {host}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "out",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "byte_in_binary_bytes_family"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Pod network in (bytes/s) by deployment",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes.network.rx_bytes{$cluster,$namespace} by {kube_deployment}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "byte_in_binary_bytes_family"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Pod network out (bytes/s) by deployment",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes.network.tx_bytes{$cluster,$namespace} by {kube_deployment}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "byte_in_binary_bytes_family"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 12,
        "height": 7
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Node utilization",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU requested % of allocatable by node",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:kubernetes_state.container.cpu_requested{$cluster} by {node}",
                      "aggregator": "avg"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:kubernetes_state.node.cpu_allocatable{$cluster} by {node}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "r / c * 100",
                      "alias": "CPU requested %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "error dashed",
                  "label": "85%"
                },
                {
                  "value": "y = 70",
                  "display_type": "warning dashed",
                  "label": "70%"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memory requested % of allocatable by node",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:kubernetes_state.container.memory_requested{$cluster} by {node}",
                      "aggregator": "avg"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:kubernetes_state.node.memory_allocatable{$cluster} by {node}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "r / c * 100",
                      "alias": "memory requested %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "error dashed",
                  "label": "85%"
                },
                {
                  "value": "y = 70",
                  "display_type": "warning dashed",
