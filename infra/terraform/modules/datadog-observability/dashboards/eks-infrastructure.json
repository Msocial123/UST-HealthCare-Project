            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 18,
        "width": 12,
        "height": 7
      }
    },
    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Workloads",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "toplist",
              "title": "Container restarts by deployment",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes.containers.restarts{$cluster,$namespace} by {kube_deployment}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Available replicas by deployment",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes_state.deployment.replicas_available{$cluster,$namespace} by {kube_deployment}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 25,
        "width": 12,
        "height": 4
