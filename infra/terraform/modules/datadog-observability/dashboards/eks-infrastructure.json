              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Running pods per node",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:kubernetes.pods.running{$cluster} by {host}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "pods"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Disk used % by host",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.disk.in_use{$cluster} by {host}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 100",
                      "alias": "disk %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "error dashed",
                  "label": "85%"
                },
                {
                  "value": "y = 70",
                  "display_type": "warning dashed",
                  "label": "70%"
