# Identity & Access Service configuration.
# Copy to `.env` for local development and replace EVERY placeholder. Never commit `.env`.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by the identity service (SQLAlchemy URL, psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://identity_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/identity

# JWT signing configuration.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum length: 32 bytes for HS256, 48 for HS384, 64 for HS512. The service refuses to start with a
# missing, short or placeholder secret.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_KEY_ID=k1                  # emitted as the `kid` header; change when rotating keys
JWT_ISSUER=https://identity.smart-hospital.local
JWT_AUDIENCE=smart-hospital-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15   # 1..60
JWT_LEEWAY_SECONDS=30          # clock-skew tolerance, 0..120

# Optional: retired keys still accepted for verification during rotation, as JSON {"kid": "secret"}.
# JWT_PREVIOUS_KEYS={"k0": "REPLACE_WITH_PREVIOUS_SECRET"}

# Development-only: password applied to the fictional demo accounts by `python -m app.cli seed-demo-users`.
# Must be at least 12 characters. The seed command refuses to run when APP_ENV=production.
SEED_DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
