# Appointment Service configuration.
# Copy to `.env` for local development and replace EVERY placeholder. Never commit `.env`.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by the appointment service (SQLAlchemy URL, psycopg 3 driver).
# Never point this at the patient, provider, scheduling or any other service's database.
# The migration enables the `btree_gist` extension (needs CREATE privilege on the database).
DATABASE_URL=postgresql+psycopg://appointment_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/appointment

# JWT verification. These MUST match the Identity service settings; this service only verifies tokens.
# JWT_SECRET_KEY is the same secret the Identity service signs with (min 32/48/64 bytes for HS256/384/512).
# The service refuses to start with a missing, short or placeholder secret.
JWT_SECRET_KEY=REPLACE_WITH_IDENTITY_SIGNING_SECRET
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512 (must equal the Identity service)
JWT_KEY_ID=k1                  # `kid` of the active Identity signing key
JWT_ISSUER=https://identity.smart-hospital.local
JWT_AUDIENCE=smart-hospital-api
JWT_LEEWAY_SECONDS=30          # clock-skew tolerance, 0..120

# Optional: retired Identity keys still accepted during rotation, as JSON {"kid": "secret"}.
# JWT_PREVIOUS_KEYS={"k0": "REPLACE_WITH_PREVIOUS_SECRET"}

# Feature flag for patient-facing behaviour: book, reschedule and cancel.
# false (default) -> those endpoints return 503 {"error": {"code": "feature_disabled", ...}}; reads and
# check-in/complete/no-show keep working. Setting false and restarting is rollback layer 1.
APPOINTMENTS_ENABLED=false

# Optional advisory availability check against the Scheduling service before booking/rescheduling.
# The database exclusion constraint remains the final authority on double-booking.
SCHEDULING_ADVICE_ENABLED=false
# SCHEDULING_SERVICE_URL=http://localhost:8005   # required when SCHEDULING_ADVICE_ENABLED=true
SCHEDULING_TIMEOUT_SECONDS=3   # per-request timeout; failures return 503
