# Patient Service configuration.
# Copy to `.env` for local development and replace EVERY placeholder. Never commit `.env`.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by the patient service (SQLAlchemy URL, psycopg 3 driver).
# Never point this at the identity-service database.
DATABASE_URL=postgresql+psycopg://patient_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/patient

# Access-token verification. These MUST match the identity service's JWT_* settings
# (same secret, algorithm, key ID, issuer and audience). This service only verifies tokens.
JWT_SECRET_KEY=REPLACE_WITH_IDENTITY_SERVICE_JWT_SECRET
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_KEY_ID=k1
JWT_ISSUER=https://identity.smart-hospital.local
JWT_AUDIENCE=smart-hospital-api
JWT_LEEWAY_SECONDS=30          # clock-skew tolerance, 0..120

# Optional: retired identity-service keys still accepted during rotation, as JSON {"kid": "secret"}.
# JWT_PREVIOUS_KEYS={"k0": "REPLACE_WITH_PREVIOUS_SECRET"}
