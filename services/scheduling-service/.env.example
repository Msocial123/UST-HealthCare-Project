# Scheduling & Availability Service configuration.
# Copy to `.env` for local development and replace EVERY placeholder. Never commit `.env`.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by the scheduling service (SQLAlchemy URL, psycopg 3 driver).
# Never point this at the facility, provider or any other service's database.
DATABASE_URL=postgresql+psycopg://scheduling_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/scheduling

# JWT verification. These MUST match the Identity service settings; this service only verifies tokens.
# JWT_SECRET_KEY is the same secret the Identity service signs with (min 32/48/64 bytes for HS256/384/512).
# The service refuses to start with a missing, short or placeholder secret.
JWT_SECRET_KEY=REPLACE_WITH_IDENTITY_SIGNING_SECRET
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512 (must equal the Identity service)
JWT_KEY_ID=k1                  # `kid` of the active Identity signing key
JWT_ISSUER=https://identity.smart-hospital.local
JWT_AUDIENCE=smart-hospital-api
JWT_LEEWAY_SECONDS=30          # clock-skew tolerance, 0..120

# Optional: retired Identity keys still accepted during rotation, as JSON {"kid": "secret"}.
# JWT_PREVIOUS_KEYS={"k0": "REPLACE_WITH_PREVIOUS_SECRET"}

# Facility service base URL (GET /api/v1/facilities/{id} supplies the facility timezone).
FACILITY_SERVICE_URL=http://localhost:8004
FACILITY_TIMEOUT_SECONDS=3     # per-request timeout; failures return 503

# Slot length (minutes, 5..120) used for EXTRA_HOURS exceptions.
EXTRA_HOURS_SLOT_MINUTES=15
